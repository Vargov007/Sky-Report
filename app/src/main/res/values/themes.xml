<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.SkyReport" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->

        <!-- Make Navigation Bar Transparent across all screens -->
        <item name="android:navigationBarColor">@color/translucent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>

        <!-- Optional: Make Status Bar transparent as well -->
        <item name="android:statusBarColor">@color/translucent</item>

        <item name="android:windowIsTranslucent">true</item>
    </style>

    <style name="Theme.SkyReport" parent="Base.Theme.SkyReport" />

    <style name="dialogUi" parent="Theme.AppCompat.DayNight.Dialog.Alert">
        <item name="android:textColor">@color/white</item>
        <item name="android:background">@color/translucent</item>
        <item name="textBackground">@color/transparent</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="cardCornerRadius">50dp</item>
        <item name="colorAccent">#FF5722</item> <!-- Changes button colors -->
        <item name="android:windowIsTranslucent">true</item>


    </style>
</resources>